NODE_ENV=development
PORT=3000

# Supabase — use the SESSION-MODE pooler connection string, not transaction-mode
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=postgresql://postgres.xxxxx:PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres

# Auth / OTP (MSG91)
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
JWT_SECRET=replace-with-a-random-64-char-secret-before-deploy

# WhatsApp (Wati)
WATI_API_ENDPOINT=https://live-mt-server.wati.io/xxxxx
WATI_API_KEY=

# Payments (Razorpay)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Voice AI
SARVAM_API_KEY=
OPENAI_API_KEY=

# Scheduler (Upstash QStash)
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# Observability
SENTRY_DSN=
POSTHOG_API_KEY=

# Push notifications (Firebase Admin SDK) — paste the full service account
# JSON as a single line (escape internal newlines in the private_key field,
# or base64-encode the whole file and decode it in code — pick one
# convention and document it for the team; base64 is usually easier to
# paste into Railway's env var UI without escaping issues).
FIREBASE_SERVICE_ACCOUNT_JSON=

# Security — 256-bit hex string, generate with: openssl rand -hex 32
ENCRYPTION_KEY=

API_BASE_URL=https://api.meandmech.ungakadaidigital.com
